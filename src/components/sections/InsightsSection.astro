---
import { portfolioData } from "@data/portfolioData";
const { insights, clients } = portfolioData;
---

<section class="section-shell py-14 sm:py-20" id="insights">
	<div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<p class="eyebrow">{insights.eyebrow}</p>
			<h2
				class="display mt-2 text-3xl font-bold sm:text-4xl"
				data-i18n-en={insights.heading.en}
				data-i18n-id={insights.heading.id}
			>
				{insights.heading.en}
			</h2>
		</div>
		<a
			class="inline-flex items-center gap-2 text-sm font-bold text-accent transition hover:gap-3 shrink-0"
			href="/insights"
			data-i18n-href-en="/insights"
			data-i18n-href-id="/id/insights"
		>
			<span data-i18n-en={insights.viewAll.en} data-i18n-id={insights.viewAll.id}
				>{insights.viewAll.en}</span
			>
			<i class="ti ti-arrow-up-right"></i>
		</a>
	</div>

	<div class="grid gap-5 md:grid-cols-3">
		{
			insights.articles.map((art) => (
				<article
					class={`insight-card group flex flex-col justify-between rounded-3xl border-2 border-ink p-6 shadow-[5px_5px_0_#151310] transition-all duration-300 hover:-translate-y-1 hover:shadow-[7px_7px_0_#ed4d2b] ${art.theme}`}
				>
					<div>
						<div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider opacity-60">
							<span data-i18n-en={art.category.en} data-i18n-id={art.category.id}>
								{art.category.en}
							</span>
							<span>{art.readTime}</span>
						</div>
						<h3
							class="display mt-5 text-xl font-bold leading-snug sm:text-2xl"
							data-i18n-en={art.title.en}
							data-i18n-id={art.title.id}
						>
							{art.title.en}
						</h3>
						<p
							class="mt-3 text-xs sm:text-sm leading-relaxed opacity-75"
							data-i18n-en={art.desc.en}
							data-i18n-id={art.desc.id}
						>
							{art.desc.en}
						</p>
					</div>
					<div class="mt-8 pt-4 border-t border-current/15 flex items-center justify-between">
						<a
							href={art.link}
							data-i18n-href-en={art.link}
							data-i18n-href-id={`/id${art.link}`}
							class="inline-flex items-center gap-2 text-xs font-bold transition group-hover:gap-3"
						>
							<span data-i18n-en={insights.readArticle.en} data-i18n-id={insights.readArticle.id}>
								{insights.readArticle.en}
							</span>{" "}
							<i class="ti ti-arrow-right" />
						</a>
					</div>
				</article>
			))
		}
	</div>
</section>

<section class="border-y-2 border-ink bg-white py-14 sm:py-16" id="clients">
	<div class="section-shell">
		<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="eyebrow">{clients.eyebrow}</p>
				<h2
					class="display mt-2 text-2xl font-bold sm:text-4xl"
					data-i18n-en={clients.heading.en}
					data-i18n-id={clients.heading.id}
				>
					{clients.heading.en}
				</h2>
			</div>
			<p
				class="max-w-xl text-xs sm:text-sm leading-relaxed text-ink/65"
				data-i18n-en={clients.subtext.en}
				data-i18n-id={clients.subtext.id}
			>
				{clients.subtext.en}
			</p>
		</div>

		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				clients.items.map((c) => (
					<article
						class={`group rounded-2xl border-2 border-ink ${c.bg} p-5 transition duration-200 hover:-translate-y-1 hover:shadow-[5px_5px_0_#151310]`}
					>
						<div class="flex items-center justify-between">
							<strong class="display text-lg font-bold">{c.name}</strong>
							<i class={`ti ${c.icon} text-2xl text-accent`} />
						</div>
						<p
							class="mt-4 text-xs font-bold uppercase tracking-wider opacity-50"
							data-i18n-en={c.industry.en}
							data-i18n-id={c.industry.id}
						>
							{c.industry.en}
						</p>
					</article>
				))
			}
		</div>
	</div>
</section>
