        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-bold text-ink/50 uppercase tracking-wider text-[11px]">Phone / WA</span>
          <a class="font-bold text-ink hover:text-accent transition-colors underline decoration-ink/25" href="tel:+6281370004025">+62 813-7000-4025</a>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-bold text-ink/50 uppercase tracking-wider text-[11px]">Email</span>
          <a class="font-bold text-ink hover:text-accent transition-colors underline decoration-ink/25 break-all" href="mailto:brianalviano.official@gmail.com">brianalviano.official@gmail.com</a>
