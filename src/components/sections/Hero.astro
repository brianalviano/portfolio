---
import { portfolioData } from "@data/portfolioData";
const { hero } = portfolioData;
---

<section class="relative flex min-h-screen flex-col overflow-hidden pt-20" id="home">
	<div class="absolute -right-24 top-36 h-72 w-72 rounded-full border-[28px] border-accent/20">
	</div>
	<svg
		aria-hidden="true"
		class="absolute -left-20 bottom-20 h-64 w-64 text-accent/20"
		fill="none"
		viewBox="0 0 200 200"
	>
		<path
			d="M20 100h160M100 20v160M42 42l116 116M158 42L42 158"
			stroke="currentColor"
			stroke-width="16"></path>
	</svg>
	<div
		class="section-shell grid flex-1 items-center gap-8 py-8 sm:py-10 lg:grid-cols-[1.18fr_.82fr] lg:gap-10 lg:py-10"
	>
		<div>
			<div
				class="hero-fade-1 mb-4 inline-flex items-stretch overflow-hidden rounded-full border-2 border-ink bg-white shadow-[4px_4px_0_#151310] transition duration-300 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_#151310]"
			>
				<span
					class="display grid min-w-14 place-items-center bg-accent px-4 text-sm font-bold text-white"
					>&lt;BA/&gt;</span
				>
				<span
					class="flex items-center gap-3 px-4 py-2.5 text-[11px] font-bold uppercase tracking-[.18em] sm:text-xs"
				>
					<span aria-hidden="true" class="relative flex h-2.5 w-2.5">
						<span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-40"
						></span>
						<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
					</span>
					<span data-i18n-en={hero.badge.en} data-i18n-id={hero.badge.id}>{hero.badge.en}</span>
				</span>
			</div>
			<h1
				class="display hero-fade-2 max-w-5xl text-[clamp(2.5rem,5.5vw,5.5rem)] font-bold leading-[.92] tracking-[-.06em]"
			>
				<span data-i18n-en={hero.headline.en} data-i18n-id={hero.headline.id}
					>{hero.headline.en}</span
				>
			</h1>
			<div
				class="hero-fade-3 mt-5 grid gap-4 border-t border-ink/20 pt-4 sm:grid-cols-[1fr_auto] sm:items-end"
			>
				<p
					class="max-w-2xl text-base leading-relaxed text-ink/70 sm:text-lg"
					data-i18n-en={hero.subhead.en}
					data-i18n-id={hero.subhead.id}
				>
					{hero.subhead.en}
				</p>
				<a
					class="group inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-ink bg-accent text-xl transition hover:rotate-45"
					href="#work"
				>
					<i class="ti ti-arrow-down-right transition-transform group-hover:scale-110"></i>
				</a>
			</div>
		</div>
		<div class="hero-fade-visual relative mx-auto w-full max-w-[25.5rem]">
			<div class="absolute -inset-5 rotate-3 rounded-[2.2rem] border-2 border-ink bg-accent"></div>
			<div
				class="relative overflow-hidden rounded-[2rem] border-2 border-ink bg-ink p-4 text-white shadow-[10px_10px_0_rgba(237,77,43,.35)]"
			>
				<div
					class="grid-bg relative min-h-[330px] overflow-hidden rounded-2xl bg-[#24211d] p-5 sm:min-h-[360px]"
				>
					<div class="relative z-10 flex items-start justify-between">
						<div>
							<p
								class="text-xs uppercase tracking-[.25em] text-white/45"
								data-i18n-en={hero.cardProfileTitle.en}
								data-i18n-id={hero.cardProfileTitle.id}
							>
								{hero.cardProfileTitle.en}
							</p>
							<h2 class="display mt-2 text-2xl font-bold sm:text-3xl">Brian<br />Alviano</h2>
						</div>
						<span class="rounded-full border border-white/20 px-3 py-1 text-xs"
							>{hero.location}</span
						>
					</div>
					<div class="absolute inset-x-0 bottom-0 flex justify-center">
						<svg
							aria-label="Abstract developer portrait"
							class="w-[70%] sm:w-[74%]"
							fill="none"
							viewBox="0 0 420 440"
						>
							<circle cx="210" cy="150" fill="#ED4D2B" r="90"></circle>
							<path d="M95 440c8-130 56-195 115-195s108 65 115 195H95Z" fill="#F5F1EB"></path>
							<circle cx="210" cy="153" fill="#D8A47F" r="66"></circle>
							<path
								d="M143 146c0-68 38-103 92-83 28 10 44 39 39 78-25-14-51-24-78-22-19 2-36 12-53 27Z"
								fill="#151310"></path>
							<path
								d="M171 152h-30v-12h30v12Zm108 0h-30v-12h30v12Zm-108-6h78"
								stroke="#151310"
								stroke-width="7"></path>
							<path
								d="M185 193c18 13 33 13 51 0"
								stroke="#151310"
								stroke-linecap="round"
								stroke-width="7"></path>
							<path d="M132 317c47 26 109 26 156 0" stroke="#ED4D2B" stroke-width="15"></path>
							<path d="M130 400h160" stroke="#151310" stroke-width="18"></path>
						</svg>
					</div>
					<div
						class="absolute bottom-5 left-5 z-20 rounded-xl border border-white/20 bg-[#151310]/85 px-4 py-2.5 shadow-md"
					>
						<p
							class="text-xs text-white/50"
							data-i18n-en={hero.primaryStackLabel.en}
							data-i18n-id={hero.primaryStackLabel.id}
						>
							{hero.primaryStackLabel.en}
						</p>
						<p class="mt-1 font-semibold">{hero.primaryStack}</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="shrink-0 overflow-hidden border-y-2 border-ink bg-ink py-3 text-white">
		<div
			class="marquee-track flex w-max gap-12 whitespace-nowrap text-base font-bold uppercase tracking-[.15em] sm:text-lg"
		>
			<span>{hero.marquee[0]}</span>
			<span>{hero.marquee[1]}</span>
		</div>
	</div>
</section>
