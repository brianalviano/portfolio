---
import ContactForm from './ContactForm.svelte';
import FooterShine from './FooterShine.svelte';
import { IconBrandGithub, IconBrandLinkedin, IconBrandInstagram, IconRss } from '@tabler/icons-svelte';
---

<footer class="bg-ink text-white pt-20 pb-12 border-t-2 border-ink" id="contact">
	<div class="section-shell space-y-16">
		<!-- Contact Form Section -->
		<div class="max-w-4xl mx-auto">
			<ContactForm client:visible />
		</div>

		<!-- Footer Name Spotlight Effect -->
		<div class="text-center pt-8 border-t border-white/10 overflow-hidden">
			<FooterShine client:visible />
		</div>

		<!-- Bottom Bar -->
		<div class="flex flex-col sm:flex-row items-center justify-between gap-6 pt-8 border-t border-white/10 text-xs font-semibold text-white/60">
			<p>© {new Date().getFullYear()} Brian Alviano. Built with Astro, Svelte 5 & Tailwind CSS.</p>

			<div class="flex items-center gap-6">
				<a href="https://github.com/brianalviano" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
					<IconBrandGithub size={16} /> GitHub
				</a>
				<a href="https://linkedin.com/in/brianalviano" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
					<IconBrandLinkedin size={16} /> LinkedIn
				</a>
				<a href="https://instagram.com/vinnoo_" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
					<IconBrandInstagram size={16} /> Instagram
				</a>
				<a href="/rss.xml" class="hover:text-white transition-colors flex items-center gap-1">
					<IconRss size={16} /> RSS Feed
				</a>
			</div>
		</div>
	</div>
</footer>
