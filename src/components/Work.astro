                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Laravel</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">MySQL</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">JavaScript</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">REST API</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Role access</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right 10%: Slim Vertical Pull Strip Trigger -->
        <button
          type="button"
          data-open-drawer="simetik"
          aria-label="Open SIMETIK Case Study"
          class="w-16 sm:w-20 shrink-0 bg-ink hover:bg-accent text-white border-l-2 border-ink flex flex-col items-center justify-center gap-3 p-3 transition-colors duration-200 cursor-pointer group/btn"
        >
          <i class="ti ti-layout-sidebar-right-collapse text-2xl text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
          <span class="display text-[10px] sm:text-[11px] font-extrabold uppercase tracking-widest text-white/80 group-hover/btn:text-white [writing-mode:vertical-lr] rotate-180">
            SEE DETAILS
          </span>
          <i class="ti ti-arrow-left text-lg text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
        </button>
      </div>
    </article>

    <!-- Secondary Grid: Pelangi UV & Maha Koding -->
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Pelangi UV -->
      <article class="project group overflow-hidden rounded-3xl border-2 border-ink bg-[#f6d7e6] shadow-[6px_6px_0_#151310] transition-all duration-300 hover:shadow-[8px_8px_0_#ed4d2b]">
        <div class="flex items-stretch justify-between h-full">
          <div class="flex-1 p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="text-xs font-bold uppercase tracking-widest text-ink/45">Corporate website</span>
                  <h3 class="display mt-2 text-2xl font-bold sm:text-3xl">Pelangi UV</h3>
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-ink/70 sm:text-sm">
                Corporate storytelling, service presentation, product catalog, and lead-generation flow for a printing-finishing company.
              </p>
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Laravel</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Tailwind CSS</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">JavaScript</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">SEO</span>
