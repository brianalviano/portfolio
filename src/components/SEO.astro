---
export interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	type?: "website" | "article";
	publishedTime?: string;
	jsonLd?: Record<string, any>;
	lang?: "en" | "id";
}

const {
	title = "Brian Alviano | Full-Stack Developer & Custom ERP Systems",
	description = "Brian Alviano is a full-stack developer in Indonesia building custom ERP platforms, REST APIs, internal tools, and high-performance business applications.",
	image = "/og-brian-alviano.png",
	canonicalURL = Astro.url.href,
	type = "website",
	publishedTime,
	jsonLd,
	lang = "en",
} = Astro.props;

const siteTitle = title.includes("Brian Alviano")
	? title
	: `${title} | Brian Alviano`;
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const enUrl = `${siteOrigin}/`;
const idUrl = `${siteOrigin}/id/`;

const defaultPersonSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Brian Alviano",
	jobTitle: "Full-Stack Developer",
	description:
		"Full-stack developer specializing in Laravel, Svelte, ERP systems, REST APIs, internal tools, dashboards, and scalable web applications.",
	email: "mailto:brianalviano.official@gmail.com",
	telephone: "+62-813-7000-4025",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Surabaya",
		addressRegion: "East Java",
		addressCountry: "ID",
	},
	knowsAbout: [
		"Laravel",
		"PHP",
		"Svelte",
		"Tailwind CSS",
		"PostgreSQL",
		"REST APIs",
		"ERP systems",
		"DevOps",
		"Database design",
	],
	sameAs: [
		"https://instagram.com/vinnoo_",
		"https://linkedin.com/in/brianalviano",
		"https://github.com/brianalviano",
	],
};

const finalJsonLd = jsonLd || defaultPersonSchema;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{siteTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Brian Alviano" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#f5f1eb" />
<meta name="color-scheme" content="light" />
<meta name="format-detection" content="telephone=yes" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- International i18n hreflang Tags for Google Indexing -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="id" href={idUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
<meta property="og:site_name" content="Brian Alviano" />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={new URL(image, Astro.site || Astro.url.origin).href} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site || Astro.url.origin).href} />

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Font Preconnect & Loading Optimization -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
  rel="stylesheet"
/>

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />
