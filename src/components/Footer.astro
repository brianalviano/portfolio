---
import { portfolioData } from "../data/portfolioData";
const { footer } = portfolioData;

interface Props {
	currentLang?: "en" | "id";
}
const { currentLang = "en" } = Astro.props;
---

<footer class="overflow-hidden bg-ink pb-8 pt-20 text-white border-t-2 border-ink">
	<div class="section-shell">
		<div
			class="flex flex-col justify-between gap-8 border-b border-white/15 pb-10 md:flex-row md:items-end"
		>
			<div>
				<p
					class="text-xs font-bold uppercase tracking-[.24em] text-accent"
					data-i18n-en={footer.tagline.en}
					data-i18n-id={footer.tagline.id}
				>
					{footer.tagline.en}
				</p>
				<p
					class="mt-3 max-w-xl text-lg leading-relaxed text-white/55"
					data-i18n-en={footer.desc.en}
					data-i18n-id={footer.desc.id}
				>
					{footer.desc.en}
				</p>
			</div>
			<div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
				{
					footer.links.map((l) => (
						<a
							class="transition hover:text-accent"
							href={l.href}
							target={l.href.startsWith("http") ? "_blank" : undefined}
						>
							{l.label}
						</a>
					))
				}
				<a
					class="transition hover:text-accent"
					href={currentLang === "id" ? "/id#home" : "#home"}
					data-i18n-en={footer.backToTop.en}
					data-i18n-id={footer.backToTop.id}
				>
					{footer.backToTop.en}
				</a>
			</div>
		</div>

		<!-- Giant Footer Name with CSS Glow Effect (0 GSAP) -->
		<a
			aria-label="Back to top"
			class="footer-name group relative mt-5 block overflow-hidden py-3"
			href={currentLang === "id" ? "/id#home" : "#home"}
		>
			<span
				class="display block whitespace-nowrap text-center text-[clamp(3.6rem,13.4vw,13rem)] font-bold leading-none tracking-[-.075em] text-white/95"
			>
				BRIAN ALVIANO
			</span>
			<span
				aria-hidden="true"
				class="footer-shine display pointer-events-none absolute inset-0 block whitespace-nowrap py-3 text-center text-[clamp(3.6rem,13.4vw,13rem)] font-bold leading-none tracking-[-.075em]"
			>
				BRIAN ALVIANO
			</span>
		</a>

		<div
			class="mt-6 flex flex-col justify-between gap-3 border-t border-white/15 pt-6 text-xs text-white/40 sm:flex-row sm:items-center"
		>
			<p>
				© {new Date().getFullYear()} Brian Alviano. <span
					data-i18n-en={footer.rights.en}
					data-i18n-id={footer.rights.id}>{footer.rights.en}</span>
			</p>
			<p
				data-i18n-en="Designed & Built in Surabaya, Indonesia"
				data-i18n-id="Dirancang & Dibangun di Surabaya, Indonesia"
			>
				Designed &amp; Built in Surabaya, Indonesia
			</p>
		</div>
	</div>
</footer>
