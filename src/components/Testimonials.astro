---
const testimonials = [
  {
    quote: "Brian rebuilt our entire multi-branch retail management system with Laravel and Svelte. Stock synchronization across 9 stores is now instantaneous, saving our operations team hours every day.",
    author: "Operations Lead",
    company: "DAKI Pet Shop",
    role: "Retail & Supply Chain",
    accentBg: "bg-[#f4d9d0]"
  },
  {
    quote: "Working with Brian on SIMETIK streamlined our medical ethical clearance portal immensely. His clear system architecture and attention to workflow security were top notch.",
    author: "Research Coordinator",
    company: "FKG Universitas Airlangga",
    role: "Academic & Medical Research",
    accentBg: "bg-[#dce7f4]"
  },
  {
    quote: "Brian transformed our company profile into a modern corporate website with seamless lead generation. Inquiries increased significantly within weeks of launch.",
    author: "Managing Director",
    company: "Pelangi UV",
    role: "Printing & Manufacturing",
    accentBg: "bg-[#f5e0a9]"
  }
];
---

<section class="section-shell py-20 sm:py-28" id="testimonials">
  <div class="mb-12 grid gap-8 lg:grid-cols-[1fr_.7fr] lg:items-end">
    <div>
      <p class="eyebrow">06 — Testimonials</p>
      <h2 class="display mt-3 text-4xl font-bold sm:text-6xl">What client partners say.</h2>
    </div>
    <p class="text-lg leading-relaxed text-ink/60">
      Direct feedback from business owners, project leads, and teams who rely on custom systems built for real operations.
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {testimonials.map((t, idx) => (
      <article class={`testimonial-card rounded-3xl border-2 border-ink p-7 sm:p-8 shadow-[6px_6px_0_#151310] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-[8px_8px_0_#ed4d2b] ${t.accentBg}`}>
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="display text-3xl font-black text-ink/20">0{idx + 1}</span>
            <div class="flex gap-1 text-accent">
              <i class="ti ti-star-filled text-sm"></i>
              <i class="ti ti-star-filled text-sm"></i>
              <i class="ti ti-star-filled text-sm"></i>
              <i class="ti ti-star-filled text-sm"></i>
              <i class="ti ti-star-filled text-sm"></i>
            </div>
          </div>
          <p class="text-sm sm:text-base leading-relaxed font-medium text-ink/85 italic">
            "{t.quote}"
          </p>
        </div>
        <div class="mt-8 border-t border-ink/15 pt-5 flex items-center justify-between">
          <div>
            <strong class="display block text-base font-bold text-ink">{t.author}</strong>
            <span class="text-xs font-semibold text-ink/60">{t.company} · {t.role}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
