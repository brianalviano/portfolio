---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('insights')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	seo={{
		title: 'Insights & Technical Notes | Brian Alviano',
		description: 'Practical guides and engineering notes on Laravel architecture, REST APIs, custom ERPs, and software engineering.',
	}}
>
	<Header slot="header" />

	<section class="py-24 pt-32 bg-paper border-b-2 border-ink">
		<div class="section-shell">
			<p class="eyebrow mb-3">Articles & Notes</p>
			<h1 class="display text-[clamp(2.5rem,6vw,5rem)] font-bold leading-none tracking-tight mb-6">
				Engineering Insights
			</h1>
			<p class="max-w-2xl text-lg text-ink/70">
				Thoughts and practical frameworks on building maintainable Laravel applications, designing predictable APIs, and architecture choices for custom ERPs.
			</p>
		</div>
	</section>

	<section class="py-16 bg-paper">
		<div class="section-shell">
			<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<article class="card-hard rounded-2xl p-6 flex flex-col justify-between hover:-translate-y-1 transition-transform">
						<div>
							<div class="flex items-center justify-between text-xs font-bold text-accent uppercase tracking-wider mb-3">
								<span>{post.data.category}</span>
								<span class="text-ink/40">{post.data.readTime}</span>
							</div>
							<h2 class="display text-xl font-bold text-ink mb-3 leading-snug">
								<a href={`/insights/${post.id}`} class="hover:text-accent transition-colors">
									{post.data.title}
								</a>
							</h2>
							<p class="text-sm text-ink/70 line-clamp-3 mb-6">
								{post.data.description}
							</p>
						</div>
						<a
							href={`/insights/${post.id}`}
							class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-accent transition-colors pt-4 border-t border-ink/10"
						>
							Read article →
						</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</BaseLayout>
