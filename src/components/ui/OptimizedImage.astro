---
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width?: number;
	height?: number;
	class?: string;
	loading?: "lazy" | "eager";
	format?: "webp" | "avif" | "png" | "jpeg";
}

const {
	src,
	alt,
	width,
	height,
	class: className = "",
	loading = "lazy",
	format = "webp",
} = Astro.props;
---

{
	typeof src === "string" ? (
		<img
			src={src}
			alt={alt}
			width={width}
			height={height}
			class={className}
			loading={loading}
			decoding="async"
		/>
	) : (
		<Image
			src={src}
			alt={alt}
			width={width}
			height={height}
			format={format}
			class={className}
			loading={loading}
		/>
	)
}
