    </div>
  </div>
</section>

<!-- Offcanvas Drawer Backdrop Overlay -->
<div
  id="drawer-backdrop"
  class="fixed inset-0 z-[90] hidden bg-ink/65 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  aria-hidden="true"
></div>

<!-- Offcanvas Drawer Panel -->
<aside
  id="project-drawer"
  class="fixed inset-y-0 right-0 z-[100] hidden w-full max-w-2xl bg-paper border-l-2 border-ink shadow-2xl flex-col transform translate-x-full transition-transform duration-300 ease-out"
  aria-labelledby="drawer-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between border-b-2 border-ink bg-white px-6 py-5 shrink-0">
    <div>
      <span id="drawer-category" class="text-xs font-bold uppercase tracking-wider text-accent">Case Study</span>
      <h3 id="drawer-title" class="display text-2xl font-bold text-ink">Project Title</h3>
    </div>
    <button
      type="button"
      id="close-drawer-btn"
      aria-label="Close drawer"
      class="grid h-10 w-10 place-items-center rounded-xl border-2 border-ink bg-paper text-ink transition hover:bg-accent hover:text-white cursor-pointer shadow-[3px_3px_0_#151310]"
    >
      <i class="ti ti-x text-xl"></i>
    </button>
  </div>

  <!-- Drawer Scrollable Body -->
  <div id="drawer-content" class="flex-1 overflow-y-auto p-6 space-y-6">
    <!-- Populated by JavaScript -->
  </div>
</aside>

