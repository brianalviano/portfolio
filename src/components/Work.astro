              </div>
              <p class="mt-3 text-xs leading-relaxed text-ink/70 sm:text-sm">
                Conversion-focused service website with clear packages, transparent pricing, FAQs, and portfolio presentation.
              </p>
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Laravel</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Tailwind CSS</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Alpine.js</span>
              <span class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-bold">Responsive UI</span>
            </div>
          </div>

          <!-- Right 10%: Vertical Strip Trigger -->
          <button
            type="button"
            data-open-drawer="maha-koding"
            aria-label="Open Maha Koding Details"
            class="w-14 sm:w-16 shrink-0 bg-ink hover:bg-accent text-white border-l-2 border-ink flex flex-col items-center justify-center gap-2 p-2.5 transition-colors duration-200 cursor-pointer group/btn"
          >
            <i class="ti ti-layout-sidebar-right-collapse text-xl text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
            <span class="display text-[9px] font-extrabold uppercase tracking-widest text-white/80 group-hover/btn:text-white [writing-mode:vertical-lr] rotate-180">
              SEE DETAILS
            </span>
            <i class="ti ti-arrow-left text-sm text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
          </button>
