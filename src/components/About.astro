<section class="section-shell pt-14 pb-6 sm:pt-16 sm:pb-8" id="about">
  <div class="grid gap-8 lg:grid-cols-[1fr_1.15fr] lg:items-start">
    <!-- Left Column: Title & Key Stats Grid -->
