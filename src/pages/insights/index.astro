---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('insights')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	seo={{
		title: 'Insights | Brian Alviano',
		description: 'Engineering notes, architecture decisions, and practical software guides by Brian Alviano.',
	}}
>
	<header class="shell nav">
		<a class="brand" href="/">
			<span class="mark">BA</span>
			<span>BRIAN<br />ALVIANO</span>
		</a>
		<a class="back" href="/">← <span>Portfolio</span></a>
	</header>

	<main class="shell listing">
		<div class="listing-head">
			<p class="meta">Insights</p>
			<h1 class="display">Notes from building real systems.</h1>
			<p class="lede">Engineering notes, architecture decisions, and practical guides for teams considering custom software.</p>
		</div>

		<div class="cards">
			{posts.map((post) => (
				<article class="card">
					<p class="meta">{post.data.category} · {post.data.readTime}</p>
					<h2 class="display">{post.data.title}</h2>
					<p>{post.data.description}</p>
					<a href={`/insights/${post.id}`}>Read article →</a>
				</article>
			))}
		</div>
	</main>

	<footer class="article-footer">
		<div class="shell">
			<strong class="display">BRIAN ALVIANO</strong>
			<p>Full-stack Laravel developer in Surabaya, Indonesia.</p>
			<a href="/#contact">Start a conversation →</a>
		</div>
	</footer>
</BaseLayout>

<style>
	:root {
		--ink: #151310;
		--paper: #f5f1eb;
		--accent: #ed4d2b;
		--muted: #756f67;
	}

	.shell {
		width: min(1180px, calc(100% - 40px));
		margin: auto;
	}

	.nav {
		height: 82px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #15131022;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
		font-weight: 800;
		line-height: 1.05;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 13px;
		background: var(--ink);
		color: white;
	}

	.back {
		color: inherit;
		text-decoration: none;
		font-weight: 700;
	}

	.back:hover {
		color: var(--accent);
	}

	.meta {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		font-size: clamp(3rem, 8vw, 7rem);
		line-height: 0.93;
		letter-spacing: -0.065em;
		max-width: 1050px;
		margin: 20px 0 28px;
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
	}

	.lede {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		max-width: 760px;
		color: var(--muted);
	}

	.listing {
		padding: 75px 0 110px;
	}

	.listing-head {
		max-width: 850px;
		margin-bottom: 55px;
	}

	.listing-head h1 {
		margin-bottom: 20px;
	}

	.cards {
		display: grid;
		gap: 20px;
	}

	.card {
		border: 2px solid var(--ink);
		border-radius: 28px;
		background: white;
		padding: 30px;
		transition: 0.25s;
	}

	.card:hover {
		transform: translateY(-5px);
		box-shadow: 8px 8px 0 var(--ink);
	}

	.card h2 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		line-height: 1.05;
		margin: 24px 0 12px;
		letter-spacing: -0.04em;
		font-family: 'Space Grotesk', sans-serif;
		font-weight: 700;
	}

	.card p {
		max-width: 760px;
		color: var(--muted);
	}

	.card a {
		display: inline-block;
		margin-top: 16px;
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	.card a:hover {
		text-decoration: underline;
	}

	.article-footer {
		background: var(--ink);
		color: white;
		padding: 55px 0;
	}

	.article-footer strong {
		display: block;
		font-size: 1.5rem;
		font-family: 'Space Grotesk', sans-serif;
		margin-bottom: 8px;
	}

	.article-footer p {
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 16px 0;
	}

	.article-footer a {
		color: white;
		font-weight: 700;
		text-decoration: underline;
	}

	.article-footer a:hover {
		color: var(--accent);
	}

	@media (max-width: 780px) {
		.nav .back span {
			display: none;
		}
	}
</style>
