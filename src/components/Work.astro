          >
            <i class="ti ti-layout-sidebar-right-collapse text-xl text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
            <span class="display text-[9px] font-extrabold uppercase tracking-widest text-white/80 group-hover/btn:text-white [writing-mode:vertical-lr] rotate-180">
              SEE DETAILS
            </span>
