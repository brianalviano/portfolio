---
import { portfolioData } from "@data/portfolioData";
const { skills } = portfolioData;
---

<section class="border-y-2 border-ink bg-ink py-20 text-white sm:py-24" id="skills">
	<div class="section-shell">
		<div class="mb-12 grid gap-8 lg:grid-cols-[1fr_.65fr] lg:items-end">
			<div>
				<p class="eyebrow">{skills.eyebrow}</p>
				<h2
					class="display mt-3 text-4xl font-bold tracking-tight sm:text-5xl"
					data-i18n-en={skills.heading.en}
					data-i18n-id={skills.heading.id}
				>
					{skills.heading.en}
				</h2>
			</div>
			<p
				class="text-base leading-relaxed text-white/55"
				data-i18n-en={skills.subtext.en}
				data-i18n-id={skills.subtext.id}
			>
				{skills.subtext.en}
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			<!-- Frontend Card -->
			<article
				class="skill-card rounded-3xl border border-white/15 bg-white/[.04] p-6 backdrop-blur transition-colors hover:border-white/30"
			>
				<div class="mb-5 flex items-center justify-between border-b border-white/10 pb-4">
					<div class="flex items-center gap-3">
						<span class="grid h-9 w-9 place-items-center rounded-xl bg-accent text-white font-bold"
							><i class="ti ti-layout-dashboard text-lg"></i></span
						>
						<h3 class="display text-xl font-bold">Frontend</h3>
					</div>
					<span class="rounded-full bg-white/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white/70">7 Tools</span>
				</div>
				<div class="grid grid-cols-2 gap-2.5">
					<div
						class="group/item relative flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/[.05] px-3 py-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-accent/15 hover:shadow-[0_0_12px_rgba(237,77,43,0.25)]"
					>
						<img
							alt="JavaScript"
							class="h-5 w-5 shrink-0"
							decoding="async"
							height="20"
							loading="lazy"
							src="https://cdn.simpleicons.org/javascript/F7DF1E"
							width="20"
