---
import { getCollection } from 'astro:content';

const featuredPosts = (await getCollection('insights'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<section class="py-20 border-t-2 border-ink bg-paper" id="insights">
	<div class="section-shell space-y-10">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
			<div class="space-y-3">
				<p class="eyebrow">Engineering Insights</p>
				<h2 class="display text-3xl sm:text-5xl font-bold tracking-tight text-ink">
					Articles & Notes
				</h2>
			</div>
			<a href="/insights" class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-accent transition-colors">
				View all articles →
			</a>
		</div>

		<div class="grid gap-8 md:grid-cols-3">
			{featuredPosts.map((post) => (
				<article class="card-hard rounded-3xl p-6 flex flex-col justify-between hover:-translate-y-1 transition-transform">
					<div>
						<div class="flex items-center justify-between text-xs font-bold text-accent uppercase tracking-wider mb-3">
							<span>{post.data.category}</span>
							<span class="text-ink/40">{post.data.readTime}</span>
						</div>
						<h3 class="display text-xl font-bold text-ink mb-3 leading-snug">
							<a href={`/insights/${post.id}`} class="hover:text-accent transition-colors">
								{post.data.title}
							</a>
						</h3>
						<p class="text-sm text-ink/70 line-clamp-3 mb-6">
							{post.data.description}
						</p>
					</div>
					<a
						href={`/insights/${post.id}`}
						class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:text-accent transition-colors pt-4 border-t border-ink/10"
					>
						Read article →
					</a>
				</article>
			))}
		</div>
	</div>
</section>
