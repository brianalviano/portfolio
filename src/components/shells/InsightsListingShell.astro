---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
	lang?: "en" | "id";
}

const { lang = "en" } = Astro.props;

const allPosts = await getCollection("insights");
const prefix = `${lang}/`;
const posts = allPosts
	.filter((post) => post.id.startsWith(prefix))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const homeHref = lang === "id" ? "/id" : "/";
const contactHref = lang === "id" ? "/id#contact" : "/#contact";
---

<BaseLayout
	lang={lang}
	seo={{
		title:
			lang === "id" ? "Artikel & Catatan Rekayasa | Brian Alviano" : "Insights | Brian Alviano",
		description:
			lang === "id"
				? "Catatan rekayasa perangkat lunak, keputusan arsitektur, dan panduan praktis pengembangan sistem oleh Brian Alviano."
				: "Engineering notes, architecture decisions, and practical software guides by Brian Alviano.",
	}}
>
	<header class="shell nav flex items-center justify-between">
		<a class="brand" href={homeHref}>
			<span class="mark">BA</span>
			<span>BRIAN<br />ALVIANO</span>
		</a>
		<div class="flex items-center gap-4">
			<div
				class="flex items-center rounded-full border-2 border-ink bg-white p-1 text-xs font-extrabold shadow-[2px_2px_0_#151310]"
			>
				<a
					href="/insights"
					onclick="localStorage.setItem('preferred_lang', 'en')"
					class={`rounded-full px-2.5 py-1 transition-colors ${lang === "en" ? "bg-ink text-white" : "text-ink/60 hover:text-ink"}`}
					>EN</a
				>
				<a
					href="/id/insights"
					onclick="localStorage.setItem('preferred_lang', 'id')"
					class={`rounded-full px-2.5 py-1 transition-colors ${lang === "id" ? "bg-ink text-white" : "text-ink/60 hover:text-ink"}`}
					>ID</a
				>
			</div>
			<a class="back" href={homeHref}>← <span>Portfolio</span></a>
		</div>
	</header>

	<main class="shell listing">
		<div class="listing-head">
			<p class="meta">Insights</p>
			<h1 class="display">
				{
					lang === "id"
						? "Catatan dari membangun sistem nyata."
						: "Notes from building real systems."
				}
			</h1>
			<p class="lede">
				{
					lang === "id"
						? "Catatan rekayasa, keputusan arsitektur, dan panduan praktis untuk tim yang mempertimbangkan software kustom."
						: "Engineering notes, architecture decisions, and practical guides for teams considering custom software."
				}
			</p>
		</div>

		<div class="cards">
			{
				posts.map((post) => {
					const slug = post.id.replace(new RegExp(`^${prefix}`), "");
					const articleHref = lang === "id" ? `/id/insights/${slug}` : `/insights/${slug}`;
					const readText = lang === "id" ? "Baca artikel →" : "Read article →";
					return (
						<article class="card">
							<p class="meta">
								{post.data.category} · {post.data.readTime}
							</p>
							<h2 class="display">{post.data.title}</h2>
							<p>{post.data.description}</p>
							<a href={articleHref}>{readText}</a>
						</article>
					);
				})
			}
		</div>
	</main>

	<footer class="article-footer">
		<div class="shell">
			<strong class="display">BRIAN ALVIANO</strong>
			<p>
				{
					lang === "id"
						? "Full-stack developer di Surabaya, Indonesia."
						: "Full-stack Laravel developer in Surabaya, Indonesia."
				}
			</p>
			<a href={contactHref}>{lang === "id" ? "Mulai diskusi →" : "Start a conversation →"}</a>
		</div>
	</footer>
</BaseLayout>

<style>
	:root {
		--ink: #151310;
		--paper: #f5f1eb;
		--accent: #ed4d2b;
		--muted: #756f67;
	}

	.shell {
		width: min(1180px, calc(100% - 40px));
		margin: auto;
	}

	.nav {
		height: 82px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #15131022;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
		font-weight: 800;
		line-height: 1.05;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 13px;
		background: var(--ink);
		color: white;
	}

	.back {
		color: inherit;
		text-decoration: none;
		font-weight: 700;
	}

	.back:hover {
		color: var(--accent);
	}

	.meta {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		font-size: clamp(3rem, 8vw, 7rem);
		line-height: 0.93;
		letter-spacing: -0.065em;
		max-width: 1050px;
		margin: 20px 0 28px;
		font-family: "Space Grotesk", sans-serif;
		font-weight: 700;
	}

	.lede {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		max-width: 760px;
		color: var(--muted);
	}

	.listing {
		padding: 75px 0 110px;
	}

	.listing-head {
		max-width: 850px;
		margin-bottom: 55px;
	}

	.listing-head h1 {
		margin-bottom: 20px;
	}

	.cards {
		display: grid;
		gap: 20px;
	}

	.card {
		border: 2px solid var(--ink);
		border-radius: 28px;
		background: white;
		padding: 30px;
		transition: 0.25s;
	}

	.card:hover {
		transform: translateY(-5px);
		box-shadow: 8px 8px 0 var(--ink);
	}

	.card h2 {
		font-size: clamp(1.8rem, 4vw, 3rem);
		line-height: 1.05;
		margin: 24px 0 12px;
		letter-spacing: -0.04em;
		font-family: "Space Grotesk", sans-serif;
		font-weight: 700;
	}

	.card p {
		max-width: 760px;
		color: var(--muted);
	}

	.card a {
		display: inline-block;
		margin-top: 16px;
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	.card a:hover {
		text-decoration: underline;
	}

	.article-footer {
		background: var(--ink);
		color: white;
		padding: 55px 0;
	}

	.article-footer strong {
		display: block;
		font-size: 1.5rem;
		font-family: "Space Grotesk", sans-serif;
		margin-bottom: 8px;
	}

	.article-footer p {
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 16px 0;
	}

	.article-footer a {
		color: white;
		font-weight: 700;
		text-decoration: underline;
	}

	.article-footer a:hover {
		color: var(--accent);
	}

	@media (max-width: 780px) {
		.nav .back span {
			display: none;
		}
	}
</style>
