                  <span class="block text-[11px] font-semibold text-ink/45">Role</span>
                  <strong class="mt-0.5 block font-bold text-ink">Full-stack developer</strong>
                </div>
                <div class="rounded-xl border border-ink/10 bg-paper p-2.5">
                  <span class="block text-[11px] font-semibold text-ink/45">Focus</span>
                  <strong class="mt-0.5 block font-bold text-ink">Workflow digitization</strong>
                </div>
                <div class="rounded-xl border border-ink/10 bg-paper p-2.5">
                  <span class="block text-[11px] font-semibold text-ink/45">Format</span>
                  <strong class="mt-0.5 block font-bold text-ink">Product system</strong>
