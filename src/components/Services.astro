---
import { portfolioData } from '../data/portfolioData';
const { services } = portfolioData;
---

<section class="section-shell pt-6 pb-16 sm:pt-8 sm:pb-24" id="services">
  <div class="mb-14 flex items-end justify-between">
    <div>
      <p class="eyebrow">{services.eyebrow}</p>
      <h2 class="display mt-3 text-4xl font-bold sm:text-6xl" data-i18n-en={services.heading.en} data-i18n-id={services.heading.id}>
        {services.heading.en}
      </h2>
    </div>
  </div>
  <div class="grid gap-5 md:grid-cols-2">
    {services.list.map((s) => (
      <article class="service-card group rounded-3xl border-2 border-ink p-7 transition hover:bg-accent hover:text-white sm:p-9 shadow-[6px_6px_0_#151310]">
        <div class="flex items-start justify-between">
          <span class="display text-sm font-bold">{s.num}</span>
          <i class={`ti ${s.icon} text-4xl text-accent group-hover:text-white transition-colors`}></i>
        </div>
        <h3 class="display mt-14 text-3xl font-bold" data-i18n-en={s.title.en} data-i18n-id={s.title.id}>
          {s.title.en}
        </h3>
        <p class="mt-3 max-w-xl text-ink/65 transition group-hover:text-white/80" data-i18n-en={s.desc.en} data-i18n-id={s.desc.id}>
          {s.desc.en}
        </p>
      </article>
    ))}
  </div>
</section>
