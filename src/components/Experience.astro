---
import { IconBriefcase, IconCalendar, IconMapPin } from '@tabler/icons-svelte';

const experiences = [
	{
		role: 'Full-Stack Laravel & System Engineer',
		type: 'Freelance / Consultant',
		period: '2022 — Present',
		location: 'Surabaya, Indonesia',
		description: 'Architecting and delivering custom ERP systems, POS integrations, inventory platforms, and REST APIs for Indonesian enterprises & SMBs.',
		achievements: [
			'Designed multi-branch inventory engine processing 50k+ daily transactions with sub-150ms latency.',
			'Built custom POS API integration with offline-first synchronization capabilities.',
			'Implemented Redis caching & queue strategies cutting server costs by 40%.',
		],
	},
	{
		role: 'Lead Web Developer',
		type: 'Project Contract',
		period: '2021 — 2022',
		location: 'Indonesia',
		description: 'Led full-stack application development using Laravel, Inertia, and MySQL for business logistics and marketing platforms.',
		achievements: [
			'Refactored legacy monolith into clean Action Pattern & DTO structure.',
			'Automated database migrations, backups, and staging deployments.',
		],
	},
];
---

<section class="py-20 border-t-2 border-ink bg-paper" id="experience">
	<div class="section-shell space-y-12">
		<div class="space-y-3">
			<p class="eyebrow">Track Record</p>
			<h2 class="display text-3xl sm:text-5xl font-bold tracking-tight text-ink">
				Professional Experience
			</h2>
		</div>

		<div class="space-y-6">
			{experiences.map((exp) => (
				<div class="card-hard rounded-3xl p-6 sm:p-8 space-y-4">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ink/10 pb-4">
						<div>
							<span class="text-xs font-bold uppercase tracking-wider text-accent">{exp.type}</span>
							<h3 class="display text-2xl font-bold text-ink">{exp.role}</h3>
						</div>
						<div class="flex items-center gap-4 text-xs font-bold text-ink/70">
							<span class="flex items-center gap-1"><IconCalendar size={16} /> {exp.period}</span>
							<span class="flex items-center gap-1"><IconMapPin size={16} /> {exp.location}</span>
						</div>
					</div>

					<p class="text-sm sm:text-base text-ink/75 leading-relaxed">{exp.description}</p>

					<div class="pt-2">
						<p class="text-xs font-bold uppercase tracking-wider text-ink/50 mb-2">Key Accomplishments</p>
						<ul class="space-y-2 text-sm font-semibold text-ink/80">
							{exp.achievements.map((ach) => (
								<li class="flex items-start gap-2">
									<span class="text-accent font-bold">→</span>
									<span>{ach}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
