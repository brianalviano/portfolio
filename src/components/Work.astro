<section class="section-shell py-16 sm:py-20" id="work">
  <div class="mb-8 grid gap-6 lg:grid-cols-[1fr_.7fr] lg:items-end sm:mb-10">
    <div>
      <p class="eyebrow">05 — Selected work</p>
      <h2 class="display mt-2 text-3xl font-bold sm:text-5xl">Case studies, not just screenshots.</h2>
    </div>
    <p class="text-base leading-relaxed text-ink/60">
      Each project explains the client context, product goals, major capabilities, technical contribution, and operational results. Click the right handle tab to open the full interactive case study drawer.
    </p>
  </div>

  <div class="space-y-6">
    <!-- DAKI Pet Shop -->
    <article class="project group overflow-hidden rounded-3xl border-2 border-ink bg-white shadow-[6px_6px_0_#151310] transition-all duration-300 hover:shadow-[8px_8px_0_#ed4d2b]">
      <div class="flex items-stretch justify-between">
        <!-- Main Content Area (Fills 90% Width) -->
        <div class="flex-1 p-6 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr] lg:items-start">
            <!-- Left Info Column -->
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="rounded-full bg-accent px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-white">ERP case study</span>
                <span class="text-xs font-semibold text-ink/50">Retail · Multi-branch</span>
              </div>
              <h3 class="display mt-3 text-2xl font-bold sm:text-3xl">DAKI Pet Shop</h3>
              <p class="mt-0.5 text-xs font-semibold italic text-ink/55">Custom retail operations platform</p>
              <p class="mt-3 text-sm leading-relaxed text-ink/75">
                <strong class="text-ink">Project brief: </strong>A unified ERP replacing disconnected branch records with one reliable view of stock, purchasing, sales, suppliers, and revenue.
              </p>

              <div class="mt-5 grid grid-cols-3 gap-2 text-xs">
                <div class="rounded-xl border border-ink/10 bg-paper p-2.5">
                  <span class="block text-[11px] font-semibold text-ink/45">Role</span>
                  <strong class="mt-0.5 block font-bold text-ink">Full-stack lead</strong>
                </div>
                <div class="rounded-xl border border-ink/10 bg-paper p-2.5">
                  <span class="block text-[11px] font-semibold text-ink/45">Focus</span>
                  <strong class="mt-0.5 block font-bold text-ink">Operational visibility</strong>
                </div>
                <div class="rounded-xl border border-ink/10 bg-paper p-2.5">
                  <span class="block text-[11px] font-semibold text-ink/45">Format</span>
                  <strong class="mt-0.5 block font-bold text-ink">Product system</strong>
                </div>
              </div>
            </div>

            <!-- Middle-Right Capabilities & Stack Box (Fills Empty Space) -->
            <div class="rounded-2xl border border-ink/10 bg-paper p-4 sm:p-5">
              <h4 class="display text-base font-bold text-accent">What it handles</h4>
              <ul class="mt-3 space-y-2 text-xs leading-relaxed text-ink/75">
                <li class="flex gap-2.5"><i class="ti ti-circle-check mt-0.5 text-base text-accent shrink-0"></i><span>Branch inventory, stock movement, returns, and stock-opname workflows.</span></li>
                <li class="flex gap-2.5"><i class="ti ti-circle-check mt-0.5 text-base text-accent shrink-0"></i><span>Purchase requests, supplier orders, receiving, and purchase history.</span></li>
                <li class="flex gap-2.5"><i class="ti ti-circle-check mt-0.5 text-base text-accent shrink-0"></i><span>Sales reporting with branch-level visibility and role-based access.</span></li>
              </ul>
              <p class="mt-4 text-[11px] font-bold uppercase tracking-wider text-ink/45">Technology stack</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Laravel</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Svelte</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Tailwind CSS</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">PostgreSQL</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Redis</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">REST API</span>
                <span class="rounded-full border border-ink/15 bg-white px-2.5 py-1 text-xs font-semibold">Docker</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right 10%: Slim Vertical Pull Strip Trigger -->
        <button
          type="button"
          data-open-drawer="daki-pet-shop"
          aria-label="Open DAKI Pet Shop Case Study"
          class="w-16 sm:w-20 shrink-0 bg-ink hover:bg-accent text-white border-l-2 border-ink flex flex-col items-center justify-center gap-3 p-3 transition-colors duration-200 cursor-pointer group/btn"
        >
          <i class="ti ti-layout-sidebar-right-collapse text-2xl text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
          <span class="display text-[10px] sm:text-[11px] font-extrabold uppercase tracking-widest text-white/80 group-hover/btn:text-white [writing-mode:vertical-lr] rotate-180">
            SEE DETAILS
          </span>
          <i class="ti ti-arrow-left text-lg text-accent group-hover/btn:text-white transition-transform group-hover/btn:-translate-x-1"></i>
        </button>
      </div>
    </article>

    <!-- SIMETIK -->
    <article class="project group overflow-hidden rounded-3xl border-2 border-ink bg-white shadow-[6px_6px_0_#151310] transition-all duration-300 hover:shadow-[8px_8px_0_#ed4d2b]">
      <div class="flex items-stretch justify-between">
        <!-- Main Content Area (Fills 90% Width) -->
        <div class="flex-1 p-6 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr] lg:items-start">
            <!-- Left Info Column -->
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="rounded-full bg-accent px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-white">Research system</span>
                <span class="text-xs font-semibold text-ink/50">University · Workflow</span>
              </div>
              <h3 class="display mt-3 text-2xl font-bold sm:text-3xl">SIMETIK</h3>
