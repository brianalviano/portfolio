---
import { portfolioData } from "@data/portfolioData";
import SectionHeader from "@components/ui/SectionHeader.astro";
const { services } = portfolioData;
---

<section class="section-shell pt-6 pb-16 sm:pt-8 sm:pb-24" id="services">
	<SectionHeader
		eyebrow={services.eyebrow}
		titleEn={services.heading.en}
		titleId={services.heading.id}
		class="mb-12 flex items-end justify-between"
	/>
	<div class="grid gap-6 md:grid-cols-2">
		{
			services.list.map((s) => (
				<article class="service-card group relative flex flex-col justify-between rounded-3xl border-2 border-ink bg-paper p-7 sm:p-8 transition-all duration-300 hover:-translate-y-1 hover:bg-accent hover:text-white shadow-[6px_6px_0_#151310] hover:shadow-[9px_9px_0_#151310]">
					<div>
						{/* Top Header Row: Number Badge & Feature Badge + Icon */}
						<div class="flex items-center justify-between gap-3">
							<div class="flex items-center gap-3">
								<span class="display grid h-12 w-12 place-items-center rounded-2xl border-2 border-ink bg-white text-base font-black text-ink shadow-[2px_2px_0_#151310] transition-colors group-hover:border-white/50 group-hover:bg-white group-hover:text-accent">
									{s.num}
								</span>
								{s.badge && (
									<span
										class="rounded-full border border-ink/20 bg-accent px-3 py-1 text-[10px] font-black uppercase tracking-wider text-white shadow-sm transition-colors group-hover:border-white/40 group-hover:bg-white group-hover:text-accent"
										data-i18n-en={s.badge.en}
										data-i18n-id={s.badge.id}
									>
										{s.badge.en}
									</span>
								)}
							</div>
							<div class="grid h-12 w-12 place-items-center rounded-2xl border-2 border-ink/15 bg-accent/10 transition-colors group-hover:border-white/30 group-hover:bg-white/15">
								<i
									class={`ti ${s.icon} text-2xl text-accent transition-colors group-hover:text-white`}
								/>
							</div>
						</div>

						{/* Title */}
						<h3
							class="display mt-7 text-2xl font-bold sm:text-3xl text-ink transition-colors group-hover:text-white"
							data-i18n-en={s.title.en}
							data-i18n-id={s.title.id}
						>
							{s.title.en}
						</h3>

						{/* Description */}
						<p
							class="mt-3 max-w-xl text-xs leading-relaxed text-ink/70 transition-colors group-hover:text-white/90 sm:text-sm"
							data-i18n-en={s.desc.en}
							data-i18n-id={s.desc.id}
						>
							{s.desc.en}
						</p>
					</div>

					{/* Actionable CTA Link */}
					<div class="mt-7 border-t border-ink/15 pt-4 group-hover:border-white/25">
						<a
							href="#contact"
							class="inline-flex items-center gap-2 text-xs font-bold text-ink transition-all group-hover:text-white group-hover:translate-x-1"
							data-i18n-en="Discuss this service →"
							data-i18n-id="Diskusi layanan ini →"
						>
							<span>Discuss this service</span>
							<i class="ti ti-arrow-right text-sm"></i>
						</a>
					</div>
				</article>
			))
		}
	</div>
</section>

