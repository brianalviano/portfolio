          ${data.meta.map(m => `
            <div class="rounded-xl border border-ink/10 bg-white p-3 shadow-sm">
              <span class="block text-[11px] font-semibold text-ink/45">${m.label}</span>
              <strong class="mt-0.5 block font-bold text-ink">${m.value}</strong>
