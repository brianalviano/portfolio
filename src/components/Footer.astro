---
import { portfolioData } from '../data/portfolioData';
const { footer } = portfolioData;
---

<footer class="border-t-2 border-ink bg-ink text-white pt-16 pb-12">
  <div class="section-shell">
    <div class="mb-14 grid gap-8 md:grid-cols-2 md:items-end">
      <div>
        <span class="eyebrow text-accent" data-i18n-en={footer.tagline.en} data-i18n-id={footer.tagline.id}>{footer.tagline.en}</span>
        <h2 class="footer-name display mt-3 text-5xl font-extrabold sm:text-7xl lg:text-8xl tracking-tight leading-none uppercase select-none">
          BRIAN ALVIANO
        </h2>
      </div>
      <div class="md:justify-self-end">
        <p class="max-w-md text-sm text-white/60 leading-relaxed" data-i18n-en={footer.desc.en} data-i18n-id={footer.desc.id}>
          {footer.desc.en}
        </p>
      </div>
    </div>
    <div class="flex flex-col gap-6 border-t border-white/15 pt-8 sm:flex-row sm:items-center sm:justify-between text-xs sm:text-sm">
      <div class="flex flex-wrap gap-6 font-bold">
        {footer.links.map((l) => (
          <a class="transition-colors hover:text-accent" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined}>{l.label}</a>
        ))}
      </div>
      <div class="flex items-center justify-between gap-4 text-white/40 font-semibold sm:justify-end">
        <span>© {new Date().getFullYear()} Brian Alviano. <span data-i18n-en={footer.rights.en} data-i18n-id={footer.rights.id}>{footer.rights.en}</span></span>
        <a class="font-bold text-white transition-colors hover:text-accent" href="#home" data-i18n-en={footer.backToTop.en} data-i18n-id={footer.backToTop.id}>{footer.backToTop.en}</a>
      </div>
    </div>
  </div>
</footer>
